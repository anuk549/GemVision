{
  "expo": {
    "name": "Gemstone Studio",
    "slug": "front-end",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sapphire-defect",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080B14",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gemvision.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#080B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gemstone Studio to access your photos to analyse gemstones.",
          "cameraPermission": "Allow Gemstone Studio to use the camera to photograph gemstones."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a18def3-b960-405d-8d07-cdfab3e9b3fe"
      }
    },
    "owner": "puladev"
  }
}
