# GemVision API configuration. Copy to .env and adjust as needed.
# All variables use the GEMVISION_ prefix.

# Server
GEMVISION_HOST=0.0.0.0
GEMVISION_PORT=8000
GEMVISION_RELOAD=false
GEMVISION_DEBUG=false

# API
GEMVISION_API_PREFIX=/api/v1
GEMVISION_DEFAULT_MODEL=efficientnet

# Comma separated list of allowed CORS origins ("*" to allow all)
GEMVISION_CORS_ORIGINS=*

# Uploads
GEMVISION_MAX_UPLOAD_MB=10

# Directory containing the trained .keras models + model_metadata.json.
# Defaults to <project-root>/ml/defect-detection/keras when unset.
# GEMVISION_MODEL_DIR=/absolute/path/to/ml/defect-detection/keras
