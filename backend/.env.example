# Server Configuration
HOST=0.0.0.0
PORT=8000

# RunPod Serverless Infrastructure
# Once models are deployed on RunPod, populate endpoint IDs and API Key below:
RUNPOD_API_KEY=
RUNPOD_FLUX_ENDPOINT_ID=
RUNPOD_INPAINTING_ENDPOINT_ID=
RUNPOD_IPADAPTER_ENDPOINT_ID=
RUNPOD_TIMEOUT_SECONDS=120
RUNPOD_POLL_INTERVAL_SECONDS=2.5
RUNPOD_MOCK_FALLBACK=true

# Black Forest Labs (BFL) FLUX API
# Add your official BFL API Key below (https://api.bfl.ai):
BFL_API_KEY=
BFL_BASE_URL=https://api.bfl.ai/v1
BFL_FLUX_MODEL=flux-2-klein-9b
BFL_INPAINTING_MODEL=flux-pro-1.0-fill
BFL_POLL_INTERVAL_SECONDS=2.0
BFL_TIMEOUT_SECONDS=120

# Google Gemini API for Intelligent Prompt Enhancement
GEMINI_API_KEY=AQ.Ab8RN6LO0ylAehs78XD8e0TR4EDD9Qfrgwxmnoqds01LSdOfQQ
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MASTER_PROMPT=You are an elite Master High-Jewelry Designer, Gemologist, and AI Diffusion Art Director specializing in bespoke luxury creations. Transform the user's raw jewelry concept into a magnificent, production-grade text-to-image diffusion prompt. Highlight the center gemstone's crystal clarity, vivid saturation, facet cut geometry, and internal scintillation reflecting its carat weight. Detail the precious metal alloy, mirror-polished finish, secure goldsmith prong architecture, gallery under-rail, and balanced structural contours. Faithfully preserve and elevate the user's core idea with authentic fine jewelry craftsmanship terminology. Include macro studio photography directives: razor-sharp facet reflections, specular caustic highlights, soft diffused shadows, clean neutral studio backdrop, 8k resolution. Output ONLY the single cohesive enhanced prompt paragraph (50-80 words) with no conversational preamble, quotes, or markdown.

